{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATA_DIR=../data DEV_NO_AUTH=${DEV_NO_AUTH:-1} tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.10",
    "hono-rate-limiter": "^0.5.4",
    "openid-client": "^6.8.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
