# Public URL users reach the page at (no trailing slash). Must be https in production (Secure cookies).
PUBLIC_URL=https://nav.tenax.lv

# Entra ID app registration (see README)
OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_SECRET=change-me

# Who is admin: users assigned this app role (preferred) ...
ADMIN_ROLE=Nav.Admin
# ... or members of this security group (object ID). Optional.
ADMIN_GROUP_ID=

# 32+ random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Set to 1 when running behind a reverse proxy other than Cloudflare, so rate limiting uses the last
# X-Forwarded-For entry. Not needed for a Cloudflare tunnel: CF-Connecting-IP is always used.
TRUST_PROXY=0

# Host port for docker compose. Behind a tunnel, publish it on this machine only (cloudflared on the same
# machine reaches it at http://localhost:8080), so nobody can skip Cloudflare by connecting to it directly.
HOST_PORT=127.0.0.1:8080
