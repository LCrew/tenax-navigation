# Public URL users reach the page at (no trailing slash). Must be https in production (Secure cookies).
PUBLIC_URL=https://nav.tenax.lv

# Entra ID app registration (see README)
OIDC_TENANT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
OIDC_CLIENT_SECRET=change-me

# Who is admin: users assigned this app role (preferred) ...
ADMIN_ROLE=Nav.Admin
# ... or members of this security group (object ID). Optional.
ADMIN_GROUP_ID=

# 32+ random chars, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Set to 1 when running behind a reverse proxy, so rate limiting uses X-Forwarded-For
TRUST_PROXY=1

# Host port for docker compose
HOST_PORT=8080
